<header class="sticky top-0 z-40 bg-slate-900/80 backdrop-blur-md border-b border-slate-800/80 px-6 py-3.5">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Brand & Realtime Indicator -->
        <div class="flex items-center gap-4">
            <a href="/dashboard" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-brand-600 flex items-center justify-center shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-bolt text-white text-lg"></i>
                </div>
                <div>
                    <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">TaskPulse</span>
                    <span class="hidden sm:inline-block text-[10px] text-indigo-400 font-semibold tracking-wider uppercase ml-1.5 px-1.5 py-0.5 rounded bg-indigo-500/10 border border-indigo-500/20">Live Sync</span>
                </div>
            </a>

            <!-- WebSocket Live Presence Badge -->
            <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span id="nav-live-status">Live Connected</span>
                <span class="text-slate-500">|</span>
                <span id="nav-online-count" class="font-bold text-white">Online: 1</span>
            </div>
        </div>

        <!-- User Profile & Actions -->
        <div class="flex items-center gap-3">
            <% if (locals.user) { %>
                <div class="flex items-center gap-3 pl-3">
                    <img 
                        src="<%= user.avatar || '/uploads/default-avatar.png' %>" 
                        onerror="this.src='/uploads/default-avatar.png'"
                        alt="Avatar" 
                        class="w-9 h-9 rounded-full object-cover border-2 border-indigo-500/60 shadow-md shadow-indigo-500/10"
                    >
                    <div class="hidden sm:block text-left">
                        <p class="text-sm font-semibold leading-tight text-slate-100"><%= user.name %></p>
                        <span class="inline-block text-[10px] font-bold uppercase tracking-wider <%= user.role === 'Admin' ? 'text-rose-400' : 'text-indigo-400' %>">
                            <%= user.role %>
                        </span>
                    </div>
                    <a 
                        href="/api/auth/logout" 
                        class="ml-2 w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-rose-400 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition"
                        title="Logout"
                    >
                        <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
                    </a>
                </div>
            <% } else { %>
                <a href="/login" class="px-4 py-2 text-sm font-semibold rounded-xl text-slate-300 hover:text-white transition">Sign In</a>
                <a href="/register" class="px-4 py-2 text-sm font-semibold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/25 transition">Sign Up</a>
            <% } %>
        </div>
    </div>
</header>

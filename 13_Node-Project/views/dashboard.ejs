<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8">
    
    <!-- Header Banner & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
                <span>Team Workspace</span>
                <span class="text-xs px-2.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-semibold uppercase tracking-wider">
                    Kanban Board
                </span>
            </h1>
            <p class="text-slate-400 text-sm mt-1">
                Real-time synchronized task management for your engineering team
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button 
                onclick="openNewTaskModal()" 
                class="px-5 py-2.5 bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-500/25 flex items-center gap-2 transition hover:-translate-y-0.5"
            >
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Add Task</span>
            </button>
        </div>
    </div>

    <!-- Stats Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="glass-card p-4 sm:p-5 rounded-2xl flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Tasks</p>
                <h3 id="stat-total" class="text-2xl sm:text-3xl font-extrabold text-white mt-1">0</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-indigo-400 text-lg border border-slate-700/60">
                <i class="fa-solid fa-layer-group"></i>
            </div>
        </div>

        <div class="glass-card p-4 sm:p-5 rounded-2xl flex items-center justify-between border-l-4 border-l-amber-500">
            <div>
                <p class="text-xs font-semibold text-amber-400 uppercase tracking-wider">To Do</p>
                <h3 id="stat-pending" class="text-2xl sm:text-3xl font-extrabold text-white mt-1">0</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-400 text-lg border border-amber-500/20">
                <i class="fa-regular fa-clock"></i>
            </div>
        </div>

        <div class="glass-card p-4 sm:p-5 rounded-2xl flex items-center justify-between border-l-4 border-l-indigo-500">
            <div>
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">In Progress</p>
                <h3 id="stat-progress" class="text-2xl sm:text-3xl font-extrabold text-white mt-1">0</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 text-lg border border-indigo-500/20">
                <i class="fa-solid fa-spinner"></i>
            </div>
        </div>

        <div class="glass-card p-4 sm:p-5 rounded-2xl flex items-center justify-between border-l-4 border-l-emerald-500">
            <div>
                <p class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Completed</p>
                <h3 id="stat-completed" class="text-2xl sm:text-3xl font-extrabold text-white mt-1">0</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 text-lg border border-emerald-500/20">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
    </div>

    <!-- 🌟 KANBAN BOARD (3 COLUMNS) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        
        <!-- COLUMN 1: TO DO (PENDING) -->
        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl">
            <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-slate-800">
                <div class="flex items-center gap-2.5">
                    <span class="w-3 h-3 rounded-full bg-amber-400 shadow-sm shadow-amber-400/50"></span>
                    <h2 class="font-bold text-sm tracking-wider uppercase text-slate-200">To Do / Pending</h2>
                </div>
                <span id="badge-pending-count" class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-400/10 text-amber-300 border border-amber-400/20">0</span>
            </div>
            <div id="col-pending" class="flex flex-col gap-3.5 min-h-[350px]">
                <!-- Cards injected here -->
            </div>
        </div>

        <!-- COLUMN 2: IN PROGRESS -->
        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl">
            <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-slate-800">
                <div class="flex items-center gap-2.5">
                    <span class="w-3 h-3 rounded-full bg-indigo-400 shadow-sm shadow-indigo-400/50"></span>
                    <h2 class="font-bold text-sm tracking-wider uppercase text-slate-200">In Progress</h2>
                </div>
                <span id="badge-progress-count" class="text-xs font-bold px-2 py-0.5 rounded-full bg-indigo-400/10 text-indigo-300 border border-indigo-400/20">0</span>
            </div>
            <div id="col-progress" class="flex flex-col gap-3.5 min-h-[350px]">
                <!-- Cards injected here -->
            </div>
        </div>

        <!-- COLUMN 3: COMPLETED -->
        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl">
            <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-slate-800">
                <div class="flex items-center gap-2.5">
                    <span class="w-3 h-3 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/50"></span>
                    <h2 class="font-bold text-sm tracking-wider uppercase text-slate-200">Completed</h2>
                </div>
                <span id="badge-completed-count" class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-400/10 text-emerald-300 border border-emerald-400/20">0</span>
            </div>
            <div id="col-completed" class="flex flex-col gap-3.5 min-h-[350px]">
                <!-- Cards injected here -->
            </div>
        </div>

    </div>

</main>

<!-- 🌟 CREATE TASK MODAL -->
<div id="task-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm hidden">
    <div class="glass-card w-full max-w-lg p-6 sm:p-7 rounded-3xl border border-slate-700/80 shadow-2xl animate-scale-up relative">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-5">
            <h3 class="text-lg font-bold text-white flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-indigo-600/30 text-indigo-400 flex items-center justify-center border border-indigo-500/30">
                    <i class="fa-solid fa-plus text-xs"></i>
                </div>
                <span>Create New Task</span>
            </h3>
            <button onclick="closeNewTaskModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="create-task-form" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Task Description</label>
                <input 
                    type="text" 
                    id="task-title" 
                    required 
                    placeholder="e.g. Implement OAuth Google Login"
                    class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition"
                >
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Priority Level</label>
                <select 
                    id="task-priority" 
                    class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition"
                >
                    <option value="Low">🟢 Low Priority</option>
                    <option value="Medium" selected>🟡 Medium Priority</option>
                    <option value="High">🔴 High Priority</option>
                </select>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
                <button type="button" onclick="closeNewTaskModal()" class="px-4 py-2.5 text-sm font-medium text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-lg shadow-indigo-600/30 transition">
                    Create & Broadcast
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<!-- 🌟 KANBAN BOARD & SOCKET.IO SCRIPT -->
<script>
    // Server-injected initial tasks & current user
    let tasks = <%- JSON.stringify(tasks) %>;
    const currentUser = <%- JSON.stringify(user) %>;

    // Render on initial load
    document.addEventListener("DOMContentLoaded", () => {
        renderKanban();
    });

    // Modal Controls
    function openNewTaskModal() {
        document.getElementById("task-modal").classList.remove("hidden");
        document.getElementById("task-title").focus();
    }

    function closeNewTaskModal() {
        document.getElementById("task-modal").classList.add("hidden");
    }

    // 1. Submit New Task via Fetch API
    document.getElementById("create-task-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const titleInput = document.getElementById("task-title");
        const priorityInput = document.getElementById("task-priority");

        const title = titleInput.value.trim();
        const priority = priorityInput.value;

        if (!title) return;

        try {
            const res = await fetch("/api/tasks", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ title, priority })
            });

            const data = await res.json();
            if (data.success) {
                titleInput.value = "";
                closeNewTaskModal();
                showToast("Task created successfully!", "success");
            } else {
                showToast(data.message || "Failed to create task", "error");
            }
        } catch (err) {
            showToast("Server error creating task", "error");
        }
    });

    // 2. Update Task Status via Fetch API
    async function updateStatus(id, newStatus) {
        try {
            const res = await fetch(`/api/tasks/${id}/status`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status: newStatus })
            });
            const data = await res.json();
            if (!data.success) {
                showToast(data.message || "Failed to update status", "error");
            }
        } catch (err) {
            showToast("Error updating task status", "error");
        }
    }

    // 3. Delete Task via Fetch API (Admin Only)
    async function deleteTask(id) {
        if (!confirm("Are you sure you want to delete this task?")) return;

        try {
            const res = await fetch(`/api/tasks/${id}`, { method: "DELETE" });
            const data = await res.json();
            if (data.success) {
                showToast("Task deleted successfully", "success");
            } else {
                showToast(data.message || "Delete failed", "error");
            }
        } catch (err) {
            showToast("Error deleting task", "error");
        }
    }

    // 4. Render Kanban Board Cards
    function renderKanban() {
        const colPending = document.getElementById("col-pending");
        const colProgress = document.getElementById("col-progress");
        const colCompleted = document.getElementById("col-completed");

        colPending.innerHTML = "";
        colProgress.innerHTML = "";
        colCompleted.innerHTML = "";

        let pendingCount = 0;
        let progressCount = 0;
        let completedCount = 0;

        tasks.forEach(task => {
            const card = createCardElement(task);

            if (task.status === "Pending") {
                colPending.appendChild(card);
                pendingCount++;
            } else if (task.status === "In Progress") {
                colProgress.appendChild(card);
                progressCount++;
            } else if (task.status === "Completed") {
                colCompleted.appendChild(card);
                completedCount++;
            }
        });

        // Update Stats Bar
        document.getElementById("stat-total").innerText = tasks.length;
        document.getElementById("stat-pending").innerText = pendingCount;
        document.getElementById("stat-progress").innerText = progressCount;
        document.getElementById("stat-completed").innerText = completedCount;

        // Update Column Badges
        document.getElementById("badge-pending-count").innerText = pendingCount;
        document.getElementById("badge-progress-count").innerText = progressCount;
        document.getElementById("badge-completed-count").innerText = completedCount;
    }

    // Helper: Create HTML Element for a single card
    function createCardElement(task) {
        const div = document.createElement("div");
        div.className = "task-card bg-slate-800/80 border border-slate-700/70 p-4 rounded-2xl shadow-sm";
        div.id = `task-${task._id}`;

        const priorityBadges = {
            High: "bg-rose-500/10 text-rose-400 border-rose-500/20",
            Medium: "bg-amber-500/10 text-amber-400 border-amber-500/20",
            Low: "bg-slate-500/10 text-slate-400 border-slate-500/20"
        };

        const avatar = task.user?.avatar || '/uploads/default-avatar.png';
        const userName = task.user?.name || 'Member';

        div.innerHTML = `
            <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="text-[10px] font-bold uppercase px-2.5 py-0.5 rounded-full border ${priorityBadges[task.priority] || priorityBadges.Medium}">
                    ${task.priority} Priority
                </span>
                ${currentUser.role === 'Admin' ? `
                    <button onclick="deleteTask('${task._id}')" class="text-slate-500 hover:text-rose-400 transition text-xs p-1" title="Delete Task">
                        <i class="fa-regular fa-trash-can"></i>
                    </button>
                ` : ''}
            </div>

            <h4 class="text-sm font-semibold text-slate-100 mb-3.5 leading-snug break-words">
                ${escapeHtml(task.title)}
            </h4>

            <div class="flex items-center justify-between pt-3 border-t border-slate-700/60 text-xs">
                <!-- User Profile -->
                <div class="flex items-center gap-2">
                    <img 
                        src="${avatar}" 
                        onerror="this.src='/uploads/default-avatar.png'"
                        alt="${escapeHtml(userName)}" 
                        class="w-6 h-6 rounded-full object-cover border border-slate-600"
                    >
                    <span class="text-slate-400 text-[11px] font-medium truncate max-w-[90px]">${escapeHtml(userName)}</span>
                </div>

                <!-- Status Selector -->
                <select 
                    onchange="updateStatus('${task._id}', this.value)" 
                    class="bg-slate-900 border border-slate-700 text-slate-300 text-[11px] font-medium py-1 px-2.5 rounded-lg focus:outline-none focus:border-indigo-500 cursor-pointer"
                >
                    <option value="Pending" ${task.status === 'Pending' ? 'selected' : ''}>To Do</option>
                    <option value="In Progress" ${task.status === 'In Progress' ? 'selected' : ''}>In Progress</option>
                    <option value="Completed" ${task.status === 'Completed' ? 'selected' : ''}>Completed</option>
                </select>
            </div>
        `;

        return div;
    }

    // ==============================================================
    // ⚡ REAL-TIME SOCKET.IO EVENT LISTENERS
    // ==============================================================
    if (globalSocket) {
        // Event 1: New task created by ANY connected user
        globalSocket.on("taskCreated", (newTask) => {
            tasks.unshift(newTask);
            renderKanban();
            showToast(`⚡ New Task: "${newTask.title}" added by ${newTask.user?.name || 'Someone'}`, "info");
        });

        // Event 2: Task status updated by ANY connected user
        globalSocket.on("taskUpdated", (updatedTask) => {
            tasks = tasks.map(t => t._id === updatedTask._id ? updatedTask : t);
            renderKanban();
            showToast(`🔄 Task moved to "${updatedTask.status}"`, "info");
        });

        // Event 3: Task deleted by Admin
        globalSocket.on("taskDeleted", (deletedId) => {
            tasks = tasks.filter(t => t._id !== deletedId);
            renderKanban();
            showToast("🗑️ Task was deleted", "warning");
        });
    }

    function escapeHtml(text) {
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return (text || '').replace(/[&<>"']/g, m => map[m]);
    }
</script>

{
  "info": {
    "_postman_id": "a5e921d7-2f88-4db8-99ee-79b8c005be7d",
    "name": "Cart Debugging API",
    "description": "Collection to test and debug the Cart Total calculation API in Node.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Calculate Total - Valid Cart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"productId\": 1, \"quantity\": 2 },\n  { \"productId\": 2, \"quantity\": 1 }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/get-post",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "get-post"
          ]
        },
        "description": "Calculates total for 2 T-Shirts ($20 each) and 1 Jeans ($60). Expected total = $100."
      },
      "response": []
    },
    {
      "name": "2. Calculate Total - Single Item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"productId\": 3, \"quantity\": 1 }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/get-post",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "get-post"
          ]
        },
        "description": "Calculates total for 1 pair of Shoes ($80). Expected total = $80."
      },
      "response": []
    },
    {

      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"productId\": 999, \"quantity\": 2 }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/get-post",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "get-post"
          ]
        },
        "description": "Tests product ID that does not exist in the catalog to check for undefined property errors."
      },
      "response": []
    },
    {
      "name": "4. Edge Case - Empty Cart Array",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/get-post",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "get-post"
          ]
        },
        "description": "Sends an empty array. Expected total = 0."
      },
      "response": []

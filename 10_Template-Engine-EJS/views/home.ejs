<%- include('partials/header') %>
    <%- include('partials/navbar') %>

        <div class="container">
            <div class="p-5 mb-4 bg-white rounded-3 shadow-sm">
                <h1 class="display-5 fw-bold text-primary">Welcome <%= username %>!!!</h1>
                <h1 class="col-md-8 fs-4">
                    <%= message %>
                </h1>
            </div>

            <!-- conditional rendering in EJS -->

            <% if(role==="Admin" ) {%>
                <div class="alert alert-success">
                    <strong>ADMIN Access : </strong> You have full Control over the Database
                </div>

                <% } else {%>
                    <div class="alert alert-info">
                        <strong>Standard User : </strong> You have viewing Permission
                    </div>

                    <% } %>


                        <a href="" class="btn btn-primary btn-lg">
                            View User Directory &rarr;
                        </a>

        </div>


           <%- include('partials/footer') %>